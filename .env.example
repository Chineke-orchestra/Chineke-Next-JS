# Copy to .env.local for local development.
# On Pantheon, set these in the Secrets Manager instead.

# The URL of your Drupal site
BACKEND_URL=https://chineke-main.ddev.site

# The public URL of this frontend, used for hreflang
# FRONTEND_URL=http://localhost:3000

# Optional: host serving images, if different from BACKEND_URL
# IMAGE_DOMAIN=some-other-domain.example

# Drupal OAuth client credentials (consumer with the nextjs_preview scope).
# The preview secret is validated by Drupal, so it is not needed here
CLIENT_ID=nextjs-frontend
CLIENT_SECRET=local-dev-secret

# Trust the DDEV mkcert CA when BACKEND_URL is https://*.ddev.site
# NODE_EXTRA_CA_CERTS="$HOME/Library/Application Support/mkcert/rootCA.pem"

# DEBUG_MODE=true
